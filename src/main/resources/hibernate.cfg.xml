<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
    "-//Hibernate/Hibernate Configuration DTD//EN"
    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="connection.url">jdbc:mysql://localhost:3306/parking</property>
    <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
    <property name="connection.username">root</property>
    <property name="connection.password">12345678</property>
      <mapping class="com.example.CourseWork.Model.Entity.Authorization"/>
    <mapping class="com.example.CourseWork.Model.Entity.Car"/>
    <mapping class="com.example.CourseWork.Model.Entity.CarInformation"/>
    <mapping class="com.example.CourseWork.Model.Entity.CarOwner"/>
    <mapping class="com.example.CourseWork.Model.Entity.CarRegistration"/>
    <mapping class="com.example.CourseWork.Model.Entity.Contracts"/>
    <mapping class="com.example.CourseWork.Model.Entity.Journal"/>
    <mapping class="com.example.CourseWork.Model.Entity.Manager"/>
    <mapping class="com.example.CourseWork.Model.Entity.ParkingSpace"/>
    <mapping class="com.example.CourseWork.Model.Entity.Payment"/>
    <mapping class="com.example.CourseWork.Model.Entity.Status"/>
    <mapping class="com.example.CourseWork.Model.Entity.Contractdocument"/>

      <!-- <property name="connection.username"/> -->
    <!-- <property name="connection.password"/> -->

    <!-- DB schema will be updated if needed -->
    <!-- <property name="hibernate.hbm2ddl.auto">update</property> -->
  </session-factory>
</hibernate-configuration>